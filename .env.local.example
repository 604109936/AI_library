# ===== Supabase 连接配置（模板，可入库供参考；真实值写在 .env.local，不入库） =====
# 取值位置：Supabase 控制台 → 左下 Project Settings（齿轮）→ API
#   - Project URL          → NEXT_PUBLIC_SUPABASE_URL
#   - Project API keys: anon public  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Project API keys: service_role → SUPABASE_SERVICE_ROLE_KEY（点 Reveal 显示）

# Project URL，形如 https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co

# anon public key：公开匿名 key，前端使用，可暴露（受 RLS 保护）
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的_anon_public_key

# service_role key：最高权限机密！仅本地导入/管理脚本使用。
# 绝不放进前端代码、绝不进 git、绝不贴聊天/截图。（本行不带 NEXT_PUBLIC_ 前缀，不会打包进浏览器）
SUPABASE_SERVICE_ROLE_KEY=你的_service_role_key

# ===== 火山引擎 豆包大模型语音识别（ASR，T6 语音输入）=====
# 取值位置：火山语音技术控制台 → 应用管理 → 「快速入门」页的「服务接口认证信息」
#   - APP ID        → VOLC_ASR_APP_ID
#   - Access Token  → VOLC_ASR_ACCESS_TOKEN（机密，仅服务端 /api/asr 使用，不带 NEXT_PUBLIC_ 前缀）
# 接入方式 VOLC_ASR_MODE：flash=极速版(同步一次返回,最快,需开通极速版) / standard=标准版(异步轮询,默认)
# 标准版需勾「豆包录音文件识别模型2.0 标准版」；极速版需勾「极速版」。resource id 随账号实测确定。
VOLC_ASR_APP_ID=你的_火山语音_AppID
VOLC_ASR_ACCESS_TOKEN=你的_火山语音_AccessToken
VOLC_ASR_MODE=standard
# 标准版资源号（默认 volc.seedasr.auc；报 45000030 未授权则换 volc.bigasr.auc）
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
# 极速版资源号（开通极速版后用；默认 volc.bigasr.auc_turbo，按账号实测覆盖）
VOLC_ASR_FLASH_RESOURCE_ID=volc.bigasr.auc_turbo
